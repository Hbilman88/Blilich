# Groupe MOCOMEL B2B Web Platform - Environment Variables
# Duplicate this file to .env.local for local overrides or configure directly in Vercel Project Settings.

# Optional: Resend API Key for automated HTML email notifications
# When omitted, the platform gracefully logs to console and returns mock success codes.
# Obtain key at: https://resend.com
RESEND_API_KEY=re_123456789_abcdefghijklmnopqrstuvwxyz

# Notification Recipient Email for RDV Avant-Vente and Devis Requests
CONTACT_TO_EMAIL=mocomel.sarl@gmail.com

# Public Portal URL
NEXT_PUBLIC_SITE_URL=https://mocomel.ma
